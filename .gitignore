# secrets & per-machine state (NEVER commit these)
data/
logs/
*.log

# your real Cloudflare tunnel config + credentials (keep private)
cloudflared/*.yml
cloudflared/*.json
!cloudflared/pc-commands.example.yml

# generated startup shortcuts
scripts/autostart/*.lnk

# per-machine watchdog state (generated by the installer)
scripts/autostart/probe.host
scripts/autostart/tunnel.match
scripts/autostart/watchdog.log

node_modules/
